// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Important Dates

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.kevinaoneill.ImportantDates

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Kevin O'Neill. All rights reserved.

// Public edition: the "iOS URL scheme" of the iOS OAuth client in
// GoogleDriveConfig.iosClientId (com.googleusercontent.apps.…). See FLAVORS_SETUP.md.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE-ME

// The public edition does not use Firebase, so its Firebase config file is
// left out of the app bundle (AppInfo-personal.xcconfig puts it back).
EXCLUDED_SOURCE_FILE_NAMES = GoogleService-Info.plist
