<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis: redraw every 6 hours so "days left" moves on with the
     date even when the app isn't opened. The app also redraws it after every change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/upcoming_dates_widget"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:previewLayout="@layout/upcoming_dates_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="21600000"
    android:widgetCategory="home_screen" />
